      "html": "<button class=\"ds-primary\">연결 승인하기 <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14 m-5-5 5 5-5 5\"/></svg></button>",
      "css": ".ds-primary{font-family:Portlane,'Malgun Gothic',sans-serif;font-size:16px;line-height:1.55;color:var(--ink,#122143);border:0;border-radius:5px;background:var(--accent,#2457d6);color:white;padding:12px 18px;min-height:44px;display:inline-flex;gap:14px;align-items:center;justify-content:center;font-size:15px;font-weight:650;cursor:pointer;transition:background .18s ease,box-shadow .18s ease}.ds-primary svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-primary:hover{background:var(--accent-hover,#1945b7);box-shadow:0 4px 10px #17388920}.ds-primary:active{background:#133992}.ds-primary:disabled{background:#526ca5;cursor:wait}.ds-primary:focus-visible{outline:3px solid var(--accent,#2457d6);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
