      "css": ".ds-notice{font-family:Portlane,'Malgun Gothic',sans-serif;font-size:16px;line-height:1.55;color:var(--ink,#122143);margin:0;background:var(--notice,#fff7ea);color:var(--notice-ink,#754a16);border-radius:var(--radius,8px);padding:12px 16px;display:flex;gap:14px;align-items:center;font-size:14px}.ds-notice svg{width:22px;height:22px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Progress Navigation",
