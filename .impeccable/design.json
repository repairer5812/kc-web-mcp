      "html": "<section class=\"ds-panel\"><h2>서버 소유자 인증</h2><p>서버 소유자 인증키를 입력합니다.</p></section>",
      "css": ".ds-panel{font-family:Portlane,'Malgun Gothic',sans-serif;font-size:16px;line-height:1.55;color:var(--ink,#122143);border:1px solid var(--line,#dae1ea);border-radius:var(--radius,8px);padding:20px 24px}.ds-panel h2{margin:0;font-size:24px;line-height:1.4;letter-spacing:-.02em;font-weight:720}.ds-panel p{margin:8px 0 0;color:var(--muted,#52647c)}"
